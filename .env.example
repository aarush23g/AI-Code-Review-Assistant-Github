APP_NAME=AI Code Review Assistant
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

GITHUB_WEBHOOK_SECRET=replace_me
GITHUB_APP_ID=replace_me
GITHUB_PRIVATE_KEY_PATH=replace_me
GITHUB_CLIENT_ID=replace_me
GITHUB_CLIENT_SECRET=replace_me

OPENAI_API_KEY=replace_me
OPENAI_MODEL=gpt-4.1-mini

REDIS_URL=redis://localhost:6379/0

MAX_REVIEW_FILES=20
MAX_REVIEW_CHUNKS=12
LARGE_PR_CHUNK_THRESHOLD=20
LARGE_PR_FILE_THRESHOLD=25
MAX_INLINE_COMMENTS=3
MIN_INLINE_COMMENT_CONFIDENCE=0.85
DEFAULT_REVIEW_MODE=quick
REVIEW_METRICS_DB_PATH=data/review_metrics.sqlite3
